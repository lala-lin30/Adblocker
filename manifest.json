
{
  "manifest_version": 3,
  "name": "Shield AdBlocker",
  "version": "1.0.0",
  "description": "Block requests to common advertising domains.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "action": {
    "default_title": "Shield AdBlocker",
    "default_popup": "popup.html"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
